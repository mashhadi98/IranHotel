# Copy this file to .env and provide local-only values before starting Compose.
# Do not commit .env or reuse these credentials outside local development.
MSSQL_SA_PASSWORD=
JWT_SIGNING_KEY=
ADMIN_SEED_PASSWORD=
OPENIDDICT_CLIENT_SECRET=

# Optional local settings
ADMIN_SEED_EMAIL=admin@example.local
ADMIN_SEED_FIRST_NAME=Local
ADMIN_SEED_LAST_NAME=Admin
OPENIDDICT_CLIENT_ID=iranhotel-local-client
OPENIDDICT_CLIENT_DISPLAY_NAME=IranHotel local client
OPENIDDICT_REDIRECT_URI=http://localhost:8080/callback
OPENIDDICT_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/signout-callback
